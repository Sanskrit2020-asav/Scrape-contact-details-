# Copy to `.env` and adjust. All values are optional; the platform runs with
# sensible defaults and degrades gracefully when integrations are absent.

# --- Company identity (used in emails & quotations) ---
COMPANY_NAME="North Nepal Travel & Trek"
COMPANY_EMAIL="partners@northnepaltrek.com"
COMPANY_WEBSITE="https://www.northnepaltrek.com"
CONSULTANT_NAME="The North Nepal Team"

# --- LLM (Anthropic Claude). Leave blank to use template fallbacks. ---
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-opus-4-8"
LLM_MAX_TOKENS="16000"

# --- Pricing ---
CURRENCY="USD"
DEFAULT_MARKUP_PCT="25"
# Point this at the company cost-estimator spreadsheet to use real prices:
PRICING_XLSX_PATH=""

# --- Knowledge base / RAG ---
# Defaults to sales_assistant/data/knowledge
KNOWLEDGE_DIR=""
MIN_RETRIEVAL_SCORE="0.05"

# --- Research ---
WEBSITE_RESEARCH_ENABLED="true"
WEB_RESEARCH_ENABLED="false"
TRUSTED_WEB_DOMAINS="himalayanrescue.org.np,welcomenepal.com,immigration.gov.np,nepal.travel"

# --- Storage (logs, learning, conversation history) ---
STORE_DIR=""
