# Copy to `.env` and adjust. All values are optional; the platform runs with
# sensible defaults and degrades gracefully when integrations are absent.

# --- Company identity (used in emails & quotations) ---
COMPANY_NAME="North Nepal Travel & Trek"
COMPANY_EMAIL="partners@northnepaltrek.com"
COMPANY_WEBSITE="https://www.northnepaltrek.com"
CONSULTANT_NAME="The North Nepal Team"

# --- LLM (Anthropic Claude). Leave blank to use template fallbacks. ---
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-opus-4-8"
LLM_MAX_TOKENS="16000"

# --- Pricing ---
CURRENCY="USD"
DEFAULT_MARKUP_PCT="25"
# Point this at the company cost-estimator spreadsheet to use real prices:
PRICING_XLSX_PATH=""

# --- Knowledge base / RAG ---
# Defaults to sales_assistant/data/knowledge
KNOWLEDGE_DIR=""
MIN_RETRIEVAL_SCORE="0.05"

# --- Research ---
WEBSITE_RESEARCH_ENABLED="true"
WEB_RESEARCH_ENABLED="false"
TRUSTED_WEB_DOMAINS="himalayanrescue.org.np,welcomenepal.com,immigration.gov.np,nepal.travel"

# --- Storage (logs, learning, conversation history) ---
STORE_DIR=""


# ==========================================================================
# NORTH NEPAL SOCIAL ENGAGEMENT AGENT  (social_agent/)
# ==========================================================================
# Independent of the sales assistant above. This application's AI provider is
# OpenAI and its social I/O runs through Apify.
# Copy to `.env` and fill in. NEVER commit `.env`.

# --- OpenAI (the only runtime AI provider) --------------------------------
OPENAI_API_KEY=""
# Any model your account can use. gpt-5 is the default; a smaller model is
# fine and cheaper for comment triage.
OPENAI_MODEL="gpt-5"
OPENAI_BASE_URL="https://api.openai.com/v1"
# "responses" (current, default) or "chat_completions" (legacy surface).
OPENAI_API_STYLE="responses"
OPENAI_TIMEOUT_SECONDS="45"
OPENAI_MAX_RETRIES="2"
OPENAI_MAX_OUTPUT_TOKENS="900"
# Leave unset: several current models accept only their default temperature.
# OPENAI_TEMPERATURE=""

# --- Apify (social media I/O) ---------------------------------------------
APIFY_API_TOKEN=""
APIFY_BASE_URL="https://api.apify.com/v2"
APIFY_TIMEOUT_SECONDS="600"
APIFY_POLL_INTERVAL_SECONDS="5"

# Actor ids. Confirm each against its own page on apify.com and adjust the
# matching input template in social_agent/apify/actor_inputs.json.
APIFY_FACEBOOK_POSTS_ACTOR="apify/facebook-posts-scraper"
APIFY_FACEBOOK_COMMENTS_ACTOR="apify/facebook-comments-scraper"
APIFY_INSTAGRAM_POSTS_ACTOR="apify/instagram-post-scraper"
APIFY_INSTAGRAM_COMMENTS_ACTOR="apify/instagram-comment-scraper"

# Reply actors are INTENTIONALLY EMPTY. Posting a reply needs an actor with
# authenticated write access to your page; no default is guessed. While these
# are empty the agent runs read-only and says so.
APIFY_FACEBOOK_REPLY_ACTOR=""
APIFY_INSTAGRAM_REPLY_ACTOR=""

# --- Which accounts to watch ----------------------------------------------
FACEBOOK_ENABLED="true"
FACEBOOK_PAGE_URL=""
FACEBOOK_ACCOUNT_ID="north_nepal_facebook"

INSTAGRAM_ENABLED="true"
INSTAGRAM_PROFILE_URL=""
INSTAGRAM_ACCOUNT_ID="north_nepal_instagram"

# Run the whole pipeline against the bundled sample comments — no Apify token
# and no real accounts needed. Ideal for a first look.
USE_MOCK_SOCIAL_DATA="false"

# --- Safety switches (V1 defaults are deliberately conservative) -----------
# Fetch, classify and draft, but publish NOTHING.
DRY_RUN="true"
# Every reply waits for a person.
HUMAN_APPROVAL_REQUIRED="true"
# Autonomous posting, off by default.
AUTO_REPLY_ENABLED="false"
AUTO_REPLY_MIN_CONFIDENCE="0.90"
MAX_REPLY_LENGTH="240"
POLLING_INTERVAL_SECONDS="300"
MAX_COMMENTS_PER_RUN="50"
MAX_POSTS_PER_RUN="10"

# A post with at least this many comments counts as high-engagement: its
# comments are processed first and the agent is shown more approved knowledge.
HIGH_ENGAGEMENT_THRESHOLD="10"

# --- Spend controls -------------------------------------------------------
# Hard stop: once this many tokens are consumed in a rolling 24 hours, the
# agent stops processing comments and says so in the dashboard. 0 = no cap.
# At roughly 460 tokens per comment, 50000 is about 100 comments a day.
DAILY_TOKEN_BUDGET="0"
# From your OpenAI pricing page, per 1,000,000 tokens. Left at 0, the dashboard
# reports "cost not configured" rather than showing a guessed figure.
OPENAI_INPUT_COST_PER_MILLION="0"
OPENAI_OUTPUT_COST_PER_MILLION="0"

# --- Dashboard ------------------------------------------------------------
DASHBOARD_HOST="127.0.0.1"
DASHBOARD_PORT="8080"
DASHBOARD_USERNAME="admin"
# Required. The dashboard refuses to start without it unless auth is disabled.
DASHBOARD_PASSWORD=""
DASHBOARD_AUTH_ENABLED="true"

# --- Storage & logging ----------------------------------------------------
DATABASE_PATH=""
LOG_LEVEL="INFO"
# "json" for production log collection, "text" for a readable terminal.
LOG_FORMAT="json"
